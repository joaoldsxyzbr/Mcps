{
  "$schema": "node_modules/wrangler/config.schema.json",
  "name": "mcps-github",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // KV onde o workers-oauth-provider guarda estados do fluxo OAuth e tokens.
  // Criar com: npx wrangler kv namespace create OAUTH_KV
  // e substituir o id abaixo pelo id retornado.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "SUBSTITUA_PELO_ID_DO_KV"
    }
  ],
  // URL pública do worker. Ajustar após o primeiro deploy com o subdomínio real.
  "vars": {
    "MCP_SERVER_URL": "https://mcps-github.SEU-SUBDOMINIO.workers.dev"
  }
}
