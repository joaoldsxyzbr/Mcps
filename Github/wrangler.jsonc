{
  "$schema": "node_modules/wrangler/config.schema.json",
  "name": "mcps",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  // KV onde o workers-oauth-provider guarda estados do fluxo OAuth e grants.
  // Criar com: npx wrangler kv namespace create OAUTH_KV
  // e substituir o id abaixo pelo id retornado.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "SUBSTITUA_PELO_ID_DO_KV"
    }
  ],
  // URL pública do endpoint MCP (com /mcp).
  "vars": {
    "MCP_SERVER_URL": "https://mcps.contato-24f.workers.dev/mcp"
  }
}
