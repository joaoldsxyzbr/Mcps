{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    // O Worker importa os adaptadores MCP dos projetos de domínio
    // (`../Github/src/mcp.ts`). Esses projetos têm node_modules próprios,
    // então as dependências compartilhadas são resolvidas por aqui.
    "paths": {
      "@modelcontextprotocol/server": ["./node_modules/@modelcontextprotocol/server"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*", "test/**/*", "../Github/src/**/*"]
}
